groups:
- name: mikrotik_alerts
  rules:
  - alert: HighCpuUsage
    expr: mktxp_system_cpu_load{} > 60
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "Высокая загрузка CPU"
      description: "CPU загружен на {{ printf \"%.1f\" $value }}% (порог 60%) дольше 5 минут."

  - alert: HighMemoryUsage
    expr: (1 - mktxp_system_free_memory{} / mktxp_system_total_memory{}) * 100 > 65
    for: 2m
    labels:
      severity: warning
    annotations:
      summary: "Высокая загрузка памяти"
      description: "Занято {{ printf \"%.2f\" $value }}% оперативной памяти (порог 65%)."

  - alert: RouterOverheat
    expr: mktxp_system_routerboard_temperature{} > 40
    for: 2m
    labels:
      severity: critical
    annotations:
      summary: "Перегрев платы"
      description: "Температура платы {{ printf \"%.1f\" $value }}°C (порог 40°C) дольше 2 минут."

  - alert: RouterCpuOverheat
    expr: mktxp_system_cpu_temperature{} > 70
    for: 2m
    labels:
      severity: critical
    annotations:
      summary: "Перегрев CPU"
      description: "Температура CPU {{ printf \"%.1f\" $value }}°C (порог 70°C) дольше 2 минут."

  - alert: LowUptime
    expr: mktxp_system_uptime{} < 100
    for: 0m
    labels:
      severity: warning
    annotations:
      summary: "Недавний перезапуск"
      description: "Устройство работает всего {{ printf \"%.0f\" $value }} секунд (менее 100) — вероятно, была перезагрузка."

  - alert: MikroTikDown
    expr: up{job="mktxp"} == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Сбор метрик mktxp недоступен"
      description: "Экспортёр {{ $labels.instance }} не отвечает дольше 5 минут — метрики со всех микротиков не обновляются."

  - alert: MikroTikUnreachable
    expr: probe_success{job="mikrotik_ping"} == 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: "Не отвечает на ping"
      description: "ICMP-ответ отсутствует дольше минуты — устройство выключено или потеряна связь."

  - alert: MikroTikPingHigh
    expr: probe_duration_seconds{job="mikrotik_ping"} > 0.5
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "Высокое время ответа"
      description: "Ответ за {{ printf \"%.0f\" $value }} мс (порог 500 мс) дольше 5 минут — возможны потери на канале."
