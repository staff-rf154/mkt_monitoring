  "panels": [
    {
      "title": "LLM V3 - Overview",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "title": "Application Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "up{job=\"llm_v3_app\"}",
          "legendFormat": "LLM V3 App"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
          ]
        }
      }
    },
    {
      "title": "Worker Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "targets": [
        {
          "expr": "up{job=\"llm_v3_worker\"}",
          "legendFormat": "LLM V3 Worker"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
          ]
        }
      }
    },
    {
      "title": "Qdrant Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "targets": [
        {
          "expr": "up{job=\"llm_v3_qdrant\"}",
          "legendFormat": "Qdrant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
          ]
        }
      }
    },
    {
      "title": "Ollama Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "targets": [
        {
          "expr": "probe_success{job=\"llm_v3_ollama\"}",
          "legendFormat": "Ollama"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
          ]
        }
      }
    },
    {
      "title": "PostgreSQL Databases",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
    },
    {
      "title": "Main DB Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "pg_stat_activity_count{job=\"llm_v3_postgres_main\", state=\"active\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "pg_stat_activity_count{job=\"llm_v3_postgres_main\", state=\"idle\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "pg_stat_activity_count{job=\"llm_v3_postgres_main\", state=\"idle in transaction\"}",
          "legendFormat": "Idle in Transaction"
        }
      ]
    },
    {
      "title": "Chat DB Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "pg_stat_activity_count{job=\"llm_v3_postgres_chat\", state=\"active\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "pg_stat_activity_count{job=\"llm_v3_postgres_chat\", state=\"idle\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "pg_stat_activity_count{job=\"llm_v3_postgres_chat\", state=\"idle in transaction\"}",
          "legendFormat": "Idle in Transaction"
        }
      ]
    },
    {
      "title": "Host Resources",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\", job=\"llm_v3_node\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes{job=\"llm_v3_node\"} - node_memory_MemAvailable_bytes{job=\"llm_v3_node\"}) / node_memory_MemTotal_bytes{job=\"llm_v3_node\"} * 100",
          "legendFormat": "Memory %"
        }
      ]
    },
    {
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "targets": [
        {
          "expr": "(node_filesystem_avail_bytes{job=\"llm_v3_node\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"llm_v3_node\", mountpoint=\"/\"}) * 100",
          "legendFormat": "Disk Free %"
        }
      ]
    },
    {
      "title": "Network Traffic",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=\"llm_v3_node\", device!=\"lo\"}[5m]) * 8",
          "legendFormat": "Receive"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{job=\"llm_v3_node\", device!=\"lo\"}[5m]) * 8",
          "legendFormat": "Transmit"
        }
      ]
    }
  ],
  "refresh": "30s",
