# Второй инстанс AmneziaWG — отдельный туннель для iPhone (Marat).
# Существующий инстанс (amnezia-wg-easy2, WG_PORT=51820, подсеть 10.8.0.0/24)
# не трогаем: его 10 клиентов продолжают работать на прежних параметрах.
#
# ВАЖНО: этот образ читает параметры маскировки БЕЗ префикса WG_
# (см. /app/config.js: process.env.JC, а не process.env.WG_JC).
# В существующем amnezia/.env стоят WG_JC/WG_JMIN/... — они игнорируются,
# реальные значения там случайные из getRandomInt().

# Порт для VPN-подключений (UDP)
WG_PORT=51822

# Порт для веб-интерфейса (TCP)
PORT=51823

# Публичный IP вашего сервера (ОБЯЗАТЕЛЬНО!)
WG_HOST=staff-rf.ru

# Пароль для входа в веб-интерфейс (ОБЯЗАТЕЛЬНО!)
PASSWORD_HASH='$2a$12$heQDWavxffx4SevdNTT8QuOcDcLVJw915/S8/7LLV50/T94/wKx7a'

# Включаем встроенный экспортер метрик
ENABLE_PROMETHEUS_METRICS=true

# Включаем детальную статистику трафика в веб-интерфейсе
UI_TRAFFIC_STATS=true

# дадут петли маршрутизации и конфликт MASQUERADE
WG_DEFAULT_ADDRESS=10.9.0.x

# MTU 1280 — мобильные сети часто не дают MSS выше этого, с 1420
# iPhone теряет пакеты и это выглядит как «DPI режет»
WG_MTU=1280

# Keepalive нужен, чтобы NAT на мобильном операторе не забывал проброс
# портов, иначе туннель засыпает после нескольких минут простоя
WG_PERSISTENT_KEEPALIVE=25

# Параметры маскировки (без префикса WG_ — так их читает образ)
JC=5
JMIN=50
JMAX=1000
S1=70
S2=51
